{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bash scripts/hooks/guard-main-checkout.sh --runtime cursor --event preToolUse",
        "matcher": "Write|StrReplace|Delete|EditNotebook"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash scripts/hooks/guard-main-checkout.sh --runtime cursor --event beforeShellExecution"
      }
    ]
  }
}
